+SystemMemoryManager::~SystemMemoryManager() {
+    // The entries held for this manager are published while its windows are open, then forgotten.
+    std::shared_ptr<HeldQueues> queues;
+    {
+        auto& table = held_table();
+        const std::lock_guard lock(table.mutex);
+        if (const auto it = table.managers.find(this); it != table.managers.end()) {
+            queues = std::move(it->second);
+            table.managers.erase(it);
+        }
+    }
+    if (!queues) {
+        return;
+    }
+    const std::lock_guard lock(queues->mutex);
+    for (auto& [cq_id, held] : queues->cqs) {
+        try {
+            publish(held);
+        } catch (const std::exception& e) {
+            log_warning(tt::LogMetal, "Held fetch-queue entries of device {} dropped: {}", this->device_id, e.what());
+            held_table().count -= held.values.size();
+            held.values.clear();
+        } catch (...) {
+            log_warning(tt::LogMetal, "Held fetch-queue entries of device {} dropped", this->device_id);
+            held_table().count -= held.values.size();
+            held.values.clear();
+        }
+    }
+}
