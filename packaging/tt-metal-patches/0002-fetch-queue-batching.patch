+// Fetch-queue batching for the calling thread (opt-in): up to `n` of its eager launches on a one-device mesh are
+// published to the device together (0 or 1: none is held). Looked up by name, so a caller needs no tt-metal header.
+// Contract: a thread that opts in must call tt_metal_flush_fetch_queues() before it blocks outside the command
+// queue (idle, host-only work, polling device memory itself); command-queue reads, events and socket waits publish.
+extern "C" __attribute__((visibility("default"))) void tt_metal_fetch_queue_batching(int n) {
+    tt::tt_metal::publish_all_held();
+    tt::tt_metal::thread_batch = n > 1 ? static_cast<uint32_t>(n) : 0;
+}
+
+// Publishes every fetch-queue entry held for eager launches.
+extern "C" __attribute__((visibility("default"))) void tt_metal_flush_fetch_queues() {
+    tt::tt_metal::publish_all_held();
+}
