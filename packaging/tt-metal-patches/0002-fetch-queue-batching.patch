+namespace program_dispatch {
+// Declared beside their callers: write_program_commands_to_devices (distributed/fd_mesh_command_queue.cpp) and
+// write_program_command_sequence (impl/program/dispatch.cpp).
+void allow_fetch_queue_hold(bool allowed) { hold_allowed = allowed; }
+void hold_next_fetch_queue_entry() { hold_next_entry = std::exchange(hold_allowed, false) && thread_batch > 1; }
+}  // namespace program_dispatch
