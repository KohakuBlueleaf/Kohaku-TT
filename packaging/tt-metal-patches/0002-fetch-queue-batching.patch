+namespace {
+
+// Fetch-queue entries of eager program launches held back on the host and published together: the values of
+// consecutive slots from `first` (an L1 address in `window`) and when the oldest was held.
+struct HeldEntries {
+    tt::umd::IoWindow* window = nullptr;
+    uint32_t first = 0;
+    std::vector<uint32_t> values;
+    std::chrono::steady_clock::time_point oldest;
+};
+
+// A manager's held entries per CQ. Its mutex is held across a publish, so the entries reach the prefetcher in slot
+// order whichever thread publishes them (an event's entry is written from a dispatch pool thread).
+struct HeldQueues {
+    std::mutex mutex;
+    std::unordered_map<uint8_t, HeldEntries> cqs;
+};
+
+// Managers that have held entries. The mutex guards the map only, never a device write. Kept here so the class
+// layout is unchanged.
+struct HeldTable {
+    std::mutex mutex;
+    std::unordered_map<const SystemMemoryManager*, std::shared_ptr<HeldQueues>> managers;
+    std::atomic<uint32_t> count{0};  // entries held in all managers: 0 skips the lookup
+};
+
+HeldTable& held_table() {
+    static auto* table = new HeldTable();  // never destroyed: used until process exit
+    return *table;
+}
+
+// Set by tt_metal_fetch_queue_batching(): entries this thread publishes together at most (0: holds none).
+thread_local uint32_t thread_batch = 0;
+
+// Set by allow_fetch_queue_hold() for a launch on a mesh of one device; consumed by hold_next_fetch_queue_entry().
+thread_local bool hold_allowed = false;
+
+// Set by hold_next_fetch_queue_entry(): this thread's next fetch_queue_write is held.
+thread_local bool hold_next_entry = false;
+
+// A held entry is published at the latest at the first launch this long after it was held.
+constexpr std::chrono::microseconds kMaxHold{50};
+
+// Writes `held`'s entries to the prefetch queue in one block (caller holds its manager's mutex).
+void publish(HeldEntries& held) {
+    if (held.values.empty()) {
+        return;
+    }
+    // The held entries' commands are in the issue queue already: make them visible first.
+    tt_driver_atomics::sfence();
+    held.window->write_block(held.first, held.values.data(), held.values.size() * sizeof(uint32_t));
+    held_table().count -= held.values.size();
+    held.values.clear();
+}
+
+std::shared_ptr<HeldQueues> held_queues(const SystemMemoryManager* manager) {
+    auto& table = held_table();
+    const std::lock_guard lock(table.mutex);
+    const auto it = table.managers.find(manager);
+    return it == table.managers.end() ? nullptr : it->second;
+}
+
+// Publishes the entries `manager` holds for `cq_id`.
+void publish_held(const SystemMemoryManager* manager, uint8_t cq_id) {
+    if (held_table().count == 0) {
+        return;
+    }
+    if (const auto queues = held_queues(manager)) {
+        const std::lock_guard lock(queues->mutex);
+        if (const auto cq = queues->cqs.find(cq_id); cq != queues->cqs.end()) {
+            publish(cq->second);
+        }
+    }
+}
+
+// Publishes every held entry.
+void publish_all_held() {
+    auto& table = held_table();
+    if (table.count == 0) {
+        return;
+    }
+    std::vector<std::shared_ptr<HeldQueues>> all;
+    {
+        const std::lock_guard lock(table.mutex);
+        for (const auto& [manager, queues] : table.managers) {
+            all.push_back(queues);
+        }
+    }
+    for (const auto& queues : all) {
+        const std::lock_guard lock(queues->mutex);
+        for (auto& [cq_id, held] : queues->cqs) {
+            publish(held);
+        }
+    }
+}
+
+}  // namespace
